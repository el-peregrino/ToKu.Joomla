<?xml version="1.0" encoding="utf-8"?>
<extension type="library" method="upgrade">
    <name>ToKu Joomla Library</name>
    <libraryname>toku</libraryname>
    <namespace path="src">ToKu\Library</namespace>
    <version>1.0.15</version>
    <author>ToKu</author>
    <authorUrl>www.toku.cz</authorUrl>
    <license>GNU General Public License version 3 or later</license>
    <creationDate>2025-07-13</creationDate>
    <description>
        <![CDATA[
            <strong>ToKu Library</strong> defines functions and resources for <em>ToKu</em> extensions. The package contains:
            <ul>
                <li>PHP Library</li>
                <li>CustomFieldSelectorField</li>
                <li>ToKu Asset (js and css)</li>
            </ul>
        ]]>
    </description>
    
    <!-- Sources -->
    <files>
        <folder>src</folder>
        <folder>layouts</folder>
    </files>

    <!-- Assets -->
    <media destination="toku" folder="media">
        <filename>joomla.asset.json</filename>
        <folder>css</folder>
        <folder>js</folder>
    </media>

    <!-- Installation Script -->
    <scriptfile>script.php</scriptfile>

    <!-- Update Servers -->
    <updateservers>
        <server type="collection">https://joomla.toku.cz/jex.toku.xml</server>
    </updateservers>
</extension>