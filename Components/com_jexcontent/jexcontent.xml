<?xml version="1.0" encoding="utf-8"?>
<extension type="component" method="upgrade">
    <name>COM_JEXCONTENT</name>
    <author>ToKu</author>
    <authorUrl>www.toku.cz</authorUrl>
    <license>GNU General Public License version 3 or later</license>
    <creationDate>2024-07-28</creationDate>
    <version>1.1.0</version>
    <description>COM_JEXCONTENT_DESCRIPTION</description>
    <namespace path="src">ToKu\Component\JexContent</namespace>

    <!-- Admin section -->
    <administration>
        <menu>
            COM_JEXCONTENT
        </menu>
        <submenu>

            <menu
			    type="component"
			    element="com_categories"
			    link="option=com_categories&amp;view=categories&amp;extension=com_jexcontent" >
                COM_JEXCONTENT_MENU_CATEGORIES
                <params>
                    <menu-quicktask-title>COM_JEXCONTENT_MENU_ADD_CATEGORY</menu-quicktask-title>
                    <menu-quicktask-icon>plus</menu-quicktask-icon>
                    <menu-quicktask>index.php?option=com_categories&amp;extension=com_jexcontent&amp;task=category.add</menu-quicktask>
                </params>
            </menu>

            <menu type="separator">separator</menu>

            <menu link="option=com_jexcontent&amp;view=sequences">
                COM_JEXCONTENT_MENU_SEQUENCES
                <params>
                    <menu-quicktask-title>COM_JEXCONTENT_MENU_ADD_SEQUENCE</menu-quicktask-title>
                    <menu-quicktask-icon>plus</menu-quicktask-icon>
                    <menu-quicktask>index.php?option=com_jexcontent&amp;view=sequences&amp;task=sequence.add</menu-quicktask>
                </params>
            </menu>

        </submenu>

        <!-- Sources -->
        <files folder="admin">
            <filename>index.html</filename>
            <filename>access.xml</filename>
            <folder>services</folder>
            <folder>src</folder>
            <folder>forms</folder>
            <folder>sql</folder>
            <folder>tmpl</folder>
        </files>

        <languages folder="admin">
            <language tag="en-GB">language/en-GB/com_jexcontent.ini</language>
            <language tag="en-GB">language/en-GB/com_jexcontent.sys.ini</language>
        </languages>
    </administration>

    <!-- Site section -->
    <!-- <site>
        <files folder="site">
            <filename>index.html</filename>
            <folder>controllers</folder>
            <folder>models</folder>
            <folder>views</folder>
            <folder>tmpl</folder>
        </files>

    </site> -->

    <!-- SQL Setup -->
    <install>
        <sql>
            <file driver="mysql" charset="utf8">sql/install.sql</file>
        </sql>
    </install>

    <uninstall>
        <sql>
            <file driver="mysql" charset="utf8">sql/uninstall.sql</file>
        </sql>
    </uninstall>

    <schemas>
        <schemapath type="mysql">sql/updates/mysql</schemapath>
    </schemas>

    <!-- Installation Script -->
    <scriptfile>script.php</scriptfile>
    
    <!-- Update Servers -->
    <updateservers>
        <server type="collection">https://joomla.toku.cz/jex.toku.xml</server>
    </updateservers>
</extension>