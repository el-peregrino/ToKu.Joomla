<?xml version="1.0" encoding="utf-8"?>
<extension type="component" method="upgrade">
    <name>COM_SEQUENCE</name>
    <author>ToKu</author>
    <authorUrl>www.toku.cz</authorUrl>
    <license>GNU General Public License version 3 or later</license>
    <creationDate>2024-07-28</creationDate>
    <version>1.0.9</version>
    <description>COM_SEQUENCE_DESCRIPTION</description>
    <namespace path="src">ToKu\Component\Sequence</namespace>

    <!-- Admin section -->
    <administration>
        <menu>
            COM_SEQUENCE
        </menu>
        <submenu>
            <menu link="option=com_sequence&amp;view=sequences">
                COM_SEQUENCE_MENU_SEQUENCES
                <params>
                    <menu-quicktask-title>COM_SEQUENCE_MENU_ADD_SEQUENCE</menu-quicktask-title>
                    <menu-quicktask-icon>plus</menu-quicktask-icon>
                    <menu-quicktask>index.php?option=com_sequence&amp;view=sequences&amp;task=sequence.add</menu-quicktask>
                </params>
            </menu>

            <menu link="option=com_sequence&amp;view=items">
                COM_SEQUENCE_MENU_ITEMS
                <params>
                    <menu-quicktask-title>COM_SEQUENCE_MENU_ADD_ITEM</menu-quicktask-title>
                    <menu-quicktask-icon>plus</menu-quicktask-icon>
                    <menu-quicktask>index.php?option=com_sequence&amp;view=items&amp;task=item.add</menu-quicktask>
                </params>
            </menu>
        </submenu>

        <files folder="admin">
            <filename>index.html</filename>
            <folder>services</folder>
            <folder>src</folder>
            <folder>forms</folder>
            <folder>sql</folder>
            <folder>tmpl</folder>
        </files>

        <languages folder="admin">
            <language tag="en-GB">language/en-GB/com_sequence.ini</language>
            <language tag="en-GB">language/en-GB/com_sequence.sys.ini</language>
        </languages>
    </administration>

    <!-- Site section -->
    <!-- <site>
        <files folder="site">
            <filename>index.html</filename>
            <folder>controllers</folder>
            <folder>models</folder>
            <folder>views</folder>
            <folder>tmpl</folder>
        </files>

    </site> -->

    <!-- SQL setup -->
    <install>
        <sql>
            <file driver="mysql" charset="utf8">sql/install.sql</file>
        </sql>
    </install>

    <uninstall>
        <sql>
            <file driver="mysql" charset="utf8">sql/uninstall.sql</file>
        </sql>
    </uninstall>

    <schemas>
        <schemapath type="mysql">sql/updates/mysql</schemapath>
    </schemas>

    <scriptfile>script.php</scriptfile>
</extension>