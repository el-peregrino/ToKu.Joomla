<?xml version="1.0" encoding="utf-8"?>
<form>
    <config>
        <inlinehelp button="show" />
    </config>

    <field name="id" type="hidden" />

    <fieldset name="title-alias">

        <field name="title" type="text" maxlength="255" required="true"
            label="JGLOBAL_TITLE" />

        <field name="alias" type="alias" filter="string" maxlength="255"
            label="JFIELD_ALIAS_LABEL"
            description="JFIELD_ALIAS_DESC"
            hint="JFIELD_ALIAS_PLACEHOLDER" />

    </fieldset>

    <fieldset name="content">

        <field name="header" type="editor" filter="safehtml"
            layout="joomla.form.field.labelabove"
            label="COM_SQ_FIELD_SEQUENCE_HEADER_LABEL"
            description="COM_SQ_FIELD_SEQUENCE_HEADER_DESCRIPTION" />

        <field name="footer" type="editor" filter="safehtml"
            layout="joomla.form.field.labelabove"
            label="COM_SQ_FIELD_SEQUENCE_FOOTER_LABEL"
            description="COM_SQ_FIELD_SEQUENCE_FOOTER_DESCRIPTION" />

    </fieldset>

    <fieldset name="general">

        <field name="type"
            type="list"
            default=""
            required="true"
            validate="options"
            label="COM_SQ_FIELD_SEQUENCE_TYPE_LABEL"
            description="COM_SQ_FIELD_SEQUENCE_TYPE_DESCRIPTION">
            <option value="">COM_SQ_SELECT_TYPE</option>
            <option value="0">COM_SQ_TYPE_LIST</option>
            <option value="1">COM_SQ_TYPE_TIMELINE</option>
        </field>

        <field name="published"
            type="list"
            label="JSTATUS"
            class="form-select-color-state"
            default="1"
            validate="options">
            <option value="0">JUNPUBLISHED</option>
            <option value="1">JPUBLISHED</option>
        </field>

        <field name="access" type="accesslevel"
            label="JFIELD_ACCESS_LABEL"
            description="JFIELD_ACCESS_DESC" />

        <field name="language" type="language"
            label="JFIELD_LANGUAGE_LABEL"
            description="JFIELD_LANGUAGE_DESC" />

        <field name="note" type="text" maxlength="255"
            label="COM_SQ_FIELD_NOTE_LABEL" />

    </fieldset>

    <fields name="images">
        <fieldset name="image-header">

            <field name="header_position"
                type="list"
                default="0"
                validate="options"
                label="COM_SQ_FIELD_IMAGE_POSITION_LABEL"
                description="COM_SQ_FIELD_IMAGE_POSITION_DESCRIPTION">
                <option value="0">COM_SQ_IMAGE_POSITION_NONE</option>
                <option value="1">COM_SQ_IMAGE_POSITION_ABOVE</option>
                <option value="2">COM_SQ_IMAGE_POSITION_BELOW</option>
            </field>

            <field
                name="image_header"
                type="media"
                schemes="http,https,ftp,ftps,data,file"
                validate="url"
                relative="true"
                showon="header_position!:0"
                label="COM_SQ_FIELD_IMAGE_LABEL" />

            <field
                name="image_header_alt"
                type="text"
                showon="header_position!:0"
                label="COM_SQ_FIELD_IMAGE_ALT_LABEL"
            />

        </fieldset>

        <fieldset name="image-footer">

            <field name="footer_position"
                type="list"
                default="0"
                validate="options"
                label="COM_SQ_FIELD_IMAGE_POSITION_LABEL"
                description="COM_SQ_FIELD_IMAGE_POSITION_DESCRIPTION">
                <option value="0">COM_SQ_IMAGE_POSITION_NONE</option>
                <option value="1">COM_SQ_IMAGE_POSITION_ABOVE</option>
                <option value="2">COM_SQ_IMAGE_POSITION_BELOW</option>
            </field>

            <field
                name="image_footer"
                type="media"
                schemes="http,https,ftp,ftps,data,file"
                validate="url"
                relative="true"
                showon="footer_position!:0"
                label="COM_SQ_FIELD_IMAGE_LABEL" />

            <field
                name="image_footer_alt"
                type="text"
                showon="footer_position!:0"
                label="COM_SQ_FIELD_IMAGE_ALT_LABEL"
            />

        </fieldset>
    </fields>
</form>