<?xml version="1.0" encoding="utf-8"?>
<form>
    <config>
        <inlinehelp button="show" />
    </config>

    <field name="id" type="hidden" />

    <fieldset name="content">

        <field
            name="date"
            type="calendar"
            showtime="true"
            format="%Y-%m-%d %H:%M"
            required="true"
            class="inputbox"
            label="COM_SQ_FIELD_DATE_LABEL"
            description="COM_SQ_FIELD_DATE_DESCRIPTION" />

        <field name="title" type="text" maxlength="255"
            label="COM_SQ_FIELD_TITLE_LABEL"
            description="COM_SQ_FIELD_TITLE_DESCRIPTION" />

        <field name="caption" type="text" maxlength="255"
            label="COM_SQ_FIELD_CAPTION_LABEL"
            description="COM_SQ_FIELD_CAPTION_DESCRIPTION" />

        <field name="heading" type="text" maxlength="255" required="true"
            label="COM_SQ_FIELD_HEADING_LABEL"
            description="COM_SQ_FIELD_HEADING_DESCRIPTION" />

        <field name="subheading" type="text" maxlength="255"
            label="COM_SQ_FIELD_SUBHEADING_LABEL"
            description="COM_SQ_FIELD_SUBHEADING_DESCRIPTION" />

        <field name="body" type="editor" filter="safehtml"
            label="COM_SQ_FIELD_BODY_LABEL" />

        <field name="footer" type="editor" filter="safehtml"
            label="COM_SQ_FIELD_FOOTER_LABEL" />

    </fieldset>

    <fields name="links">
        <fieldset name="content-link">

            <field
                name="link_type"
                type="list"
                default="none"
                label="COM_SQ_FIELD_LINK_LABEL"
                description="COM_SQ_FIELD_LINK_DESCRIPTION">
                <option value="none">COM_SQ_LINK_TYPE_NONE</option>
                <option value="menu">COM_SQ_LINK_TYPE_MENU</option>
                <option value="article">COM_SQ_LINK_TYPE_ARTICLE</option>
                <option value="external">COM_SQ_LINK_TYPE_EXTERNAL</option>
            </field>

            <field
                name="link_text"
                type="text"
                maxlength="255"
                showon="link_type!:none"
                label="COM_SQ_FIELD_LINK_TEXT_LABEL" />

            <field
                name="menu_item"
                type="menuitem"
                filter="component"
                showon="link_type:menu"
                label="COM_SQ_FIELD_LINK_MENU_LABEL" />

            <field
                type="ModalSelect"
                name="article_id"
                label="COM_SQ_FIELD_LINK_ARTICLE_LABEL"
                select="true"
                iconSelect="fa fa-list"
                titleSelect="COM_SQ_MODAL_ARTICLE"
                urlSelect="index.php?option=com_content&amp;view=articles&amp;layout=modal&amp;tmpl=component"
                clear="true"
                sql_title_table="#__content"
                sql_title_column="title"
                sql_title_key="id"
                showon="link_type:article" />

            <field
                name="external_url"
                type="url"
                showon="link_type:external"
                label="COM_SQ_FIELD_LINK_EXTERNAL_LABEL"
                description="COM_SQ_FIELD_LINK_EXTERNAL_DESCRIPTION" />

            <field
                name="link_target"
                type="list"
                default="_self"
                showon="link_type!:none"
                label="COM_SQ_FIELD_LINK_TARGET_LABEL"
                description="COM_SQ_FIELD_LINK_TARGET_DESCRIPTION">
                <option value="_self">COM_SQ_LINK_TARGET_SELF</option>
                <option value="_blank">COM_SQ_LINK_TARGET_NEW</option>
            </field>
        </fieldset>
    </fields>

    <fields name="images">
        <fieldset name="image-header">

            <field name="header_position"
                type="list"
                default="0"
                validate="options"
                label="COM_SQ_FIELD_IMAGE_POSITION_LABEL"
                description="COM_SQ_FIELD_IMAGE_POSITION_DESCRIPTION">
                <option value="0">COM_SQ_IMAGE_POSITION_NONE</option>
                <option value="1">COM_SQ_IMAGE_POSITION_ABOVE</option>
                <option value="2">COM_SQ_IMAGE_POSITION_BELOW</option>
            </field>

            <field
                name="image_header"
                type="media"
                label="COM_SQ_FIELD_IMAGE_LABEL"
                schemes="http,https,ftp,ftps,data,file"
                validate="url"
                relative="true" />

            <field
                name="image_header_alt"
                type="text"
                label="COM_SQ_FIELD_IMAGE_ALT_LABEL" />

        </fieldset>

        <fieldset name="image-footer">

            <field name="footer_position"
                type="list"
                default="0"
                validate="options"
                label="COM_SQ_FIELD_IMAGE_POSITION_LABEL"
                description="COM_SQ_FIELD_IMAGE_POSITION_DESCRIPTION">
                <option value="0">COM_SQ_IMAGE_POSITION_NONE</option>
                <option value="1">COM_SQ_IMAGE_POSITION_ABOVE</option>
                <option value="2">COM_SQ_IMAGE_POSITION_BELOW</option>
            </field>

            <field
                name="image_footer"
                type="media"
                label="COM_SQ_FIELD_IMAGE_LABEL"
                schemes="http,https,ftp,ftps,data,file"
                validate="url"
                relative="true" />

            <field
                name="image_footer_alt"
                type="text"
                label="COM_SQ_FIELD_IMAGE_ALT_LABEL" />

        </fieldset>
    </fields>

    <fieldset name="general">

        <field name="sequence_id"
            type="list"
            required="true"
            label="COM_SQ_FIELD_SEQUENCE_LABEL">
            <option value="">COM_SQ_SELECT_SEQUENCE</option>
        </field>

        <field name="published"
            type="list"
            label="JSTATUS"
            class="form-select-color-state"
            default="1"
            validate="options">
            <option value="0">JUNPUBLISHED</option>
            <option value="1">JPUBLISHED</option>
        </field>

        <field name="access" type="accesslevel"
            label="JFIELD_ACCESS_LABEL"
            description="JFIELD_ACCESS_DESC" />

        <field name="note" type="text" maxlength="255"
            label="COM_SQ_FIELD_NOTE_LABEL" />

    </fieldset>

    <fieldset name="params">

        <field name="icon" type="text" maxlength="55"
            validate="CssIdentifier"
            label="COM_SQ_FIELD_ICON_LABEL"
            description="COM_SQ_FIELD_ICON_DESCRIPTION" />

        <field name="css" type="text" maxlength="255"
            validate="CssIdentifier"
            label="COM_SQ_FIELD_CSS_LABEL"
            description="COM_SQ_FIELD_CSS_DESCRIPTION" />

        <field name="control" type="radio" default="1"
            layout="joomla.form.field.radio.switcher"
            label="COM_SQ_FIELD_CONTROL_LABEL"
            description="COM_SQ_FIELD_CONTROL_DESCRIPTION">
            <option value="0">JNo</option>
            <option value="1">JYes</option>
        </field>

        <field name="keep" type="radio" default="0"
            layout="joomla.form.field.radio.switcher"
            label="COM_SQ_FIELD_KEEP_LABEL"
            description="COM_SQ_FIELD_KEEP_DESCRIPTION">
            <option value="0">JNo</option>
            <option value="1">JYes</option>
        </field>

        <field name="initial" type="radio" default="0"
            layout="joomla.form.field.radio.switcher"
            label="COM_SQ_FIELD_INITIAL_LABEL"
            description="COM_SQ_FIELD_INITIAL_DESCRIPTION">
            <option value="0">JNo</option>
            <option value="1">JYes</option>
        </field>
    </fieldset>
</form>