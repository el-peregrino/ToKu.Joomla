<?xml version="1.0" encoding="utf-8"?>
<form>
    <config>
		<inlinehelp button="show"/>
	</config>

    <field name="id" type="hidden"/>

    <fieldset name="content">

        <field
            name="date"
            type="calendar"
            showtime="true"
            required="true"
            class="inputbox" 
            label="COM_SEQUENCE_FIELD_DATE_LABEL"
            description="COM_SEQUENCE_FIELD_DATE_DESC" />

        <field name="title" type="text" maxlength="255"
            label="COM_SEQUENCE_FIELD_TITLE_LABEL" />

        <field name="caption" type="text" maxlength="255"
            label="COM_SEQUENCE_FIELD_CAPTION_LABEL" />
        
        <field name="heading" type="text" maxlength="255" required="true"
            label="COM_SEQUENCE_FIELD_HEADING_LABEL" />

        <field name="subheading" type="text" maxlength="255"
            label="COM_SEQUENCE_FIELD_SUBHEADING_LABEL" />

        <field name="body" type="editor" filter="safehtml"
            label="COM_SEQUENCE_FIELD_BODY_LABEL" 
            description="COM_SEQUENCE_FIELD_BODY_DESCRIPTION" />

        <field name="footer" type="editor" filter="safehtml"
            label="COM_SEQUENCE_FIELD_FOOTER_LABEL" 
            description="COM_SEQUENCE_FIELD_FOOTER_DESCRIPTION" />
        
    </fieldset>

    <fields name="links">
		<fieldset name="content-link">
            
            <field 
                name="link_type" 
                type="list" 
                default="none"
                label="COM_SEQUENCE_FIELD_LINK_LABEL" 
                description="COM_SEQUENCE_FIELD_LINK_DESCRIPTION">
                <option value="none">COM_SEQUENCE_OPTION_LINK_NONE</option>
                <option value="menu">COM_SEQUENCE_OPTION_LINK_MENU</option>
                <option value="article">COM_SEQUENCE_OPTION_LINK_ARTICLE</option>
                <option value="external">COM_SEQUENCE_OPTION_LINK_EXTERNAL</option>
            </field>

            <field 
                name="link_text" 
                type="text" 
                maxlength="255"
                showon="link_type!:none"
                label="COM_SEQUENCE_FIELD_LINK_TEXT_LABEL" />

            <field 
                name="menu_item" 
                type="menuitem" 
                filter="component"
                showon="link_type:menu"
                label="COM_SEQUENCE_FIELD_LINK_MENU_LABEL" />

            <field
                type="ModalSelect"
                name="article_id"
                label="COM_SEQUENCE_FIELD_LINK_ARTICLE_LABEL"
                select="true"
                iconSelect="fa fa-list"
                titleSelect="COM_SEQUENCE_MODAL_ARTICLE"
                urlSelect="index.php?option=com_content&amp;view=articles&amp;layout=modal&amp;tmpl=component"
                clear="true"
                sql_title_table="#__content"
                sql_title_column="title"
                sql_title_key="id"
                showon="link_type:article" />

            <field 
                name="external_url" 
                type="url" 
                showon="link_type:external"
                label="COM_SEQUENCE_FIELD_LINK_EXTERNAL_LABEL" 
                description="COM_SEQUENCE_FIELD_LINK_EXTERNAL_DESCRIPTION" />

            <field 
                name="link_target" 
                type="list" 
                default="_self"
                showon="link_type!:none"
                label="COM_SEQUENCE_FIELD_LINK_TARGET_LABEL" 
                description="COM_SEQUENCE_FIELD_LINK_TARGET_DESCRIPTION" >
                <option value="_self">COM_SEQUENCE_OPTION_TARGET_SELF</option>
                <option value="_blank">COM_SEQUENCE_OPTION_TARGET_NEW</option>
            </field>
        </fieldset>
    </fields>

    <fields name="images" label="COM_SEQUENCE_FIELD_IMAGES">
		<fieldset name="image-header">

            <field name="header_position" 
                type="list" 
                default="0" 
                validate="options"
                label="COM_SEQUENCE_FIELD_IMAGE_POSITION_LABEL" 
                description="COM_SEQUENCE_FIELD_IMAGE_POSITION_DESCRIPTION">
                <option value="0">COM_SEQUENCE_IMAGE_POSITION_NONE</option>
                <option value="1">COM_SEQUENCE_IMAGE_POSITION_ABOVE</option>
                <option value="2">COM_SEQUENCE_IMAGE_POSITION_BELOW</option>
            </field>

			<field
				name="image_header"
				type="media"
				label="COM_SEQUENCE_FIELD_HEADER_IMAGE_LABEL"
				schemes="http,https,ftp,ftps,data,file"
				validate="url"
				relative="true" />

			<field
				name="image_header_alt"
				type="text"
				label="COM_SEQUENCE_FIELD_IMAGE_ALT_LABEL"
			/>

			<field
				name="image_header_alt_empty"
				type="checkbox"
				label="COM_SEQUENCE_FIELD_IMAGE_ALT_EMPTY_LABEL"
				description="COM_SEQUENCE_FIELD_IMAGE_ALT_EMPTY_DESC" />

			<field
				name="float_header"
				type="text"
				label="COM_SEQUENCE_FIELD_IMAGE_CLASS_LABEL"
				description="COM_SEQUENCE_FIELD_IMAGE_CLASS_DESC"
				useglobal="true"
				validate="CssIdentifier" />

			<field
				name="image_header_caption"
				type="text"
				label="COM_SEQUENCE_FIELD_IMAGE_CAPTION_LABEL" />

		</fieldset>

        <fieldset name="image-footer">

            <field name="footer_position" 
                type="list" 
                default="0" 
                validate="options"
                label="COM_SEQUENCE_FIELD_IMAGE_POSITION_LABEL" 
                description="COM_SEQUENCE_FIELD_IMAGE_POSITION_DESCRIPTION">
                <option value="0">COM_SEQUENCE_IMAGE_POSITION_NONE</option>
                <option value="1">COM_SEQUENCE_IMAGE_POSITION_ABOVE</option>
                <option value="2">COM_SEQUENCE_IMAGE_POSITION_BELOW</option>
            </field>

			<field
				name="image_footer"
				type="media"
				label="COM_SEQUENCE_FIELD_FOOTER_IMAGE_LABEL"
				schemes="http,https,ftp,ftps,data,file"
				validate="url"
				relative="true" />

			<field
				name="image_footer_alt"
				type="text"
				label="COM_SEQUENCE_FIELD_IMAGE_ALT_LABEL"
			/>

			<field
				name="image_footer_alt_empty"
				type="checkbox"
				label="COM_SEQUENCE_FIELD_IMAGE_ALT_EMPTY_LABEL"
				description="COM_SEQUENCE_FIELD_IMAGE_ALT_EMPTY_DESC" />

			<field
				name="float_footer"
				type="text"
				label="COM_SEQUENCE_FIELD_IMAGE_CLASS_LABEL"
				description="COM_SEQUENCE_FIELD_IMAGE_CLASS_DESC"
				useglobal="true"
				validate="CssIdentifier" />

			<field
				name="image_footer_caption"
				type="text"
				label="COM_SEQUENCE_FIELD_IMAGE_CAPTION_LABEL" />

		</fieldset>
    </fields>

    <fieldset name="general">

        <field name="sequence_id"
			type="list"
            required="true"
            label="COM_SEQUENCE_FIELD_SEQUENCE_LABEL">
            <option value="">COM_SQ_SELECT_SEQUENCE</option>
        </field>
        
        <field name="published"
			type="list"
			label="JSTATUS"
			class="form-select-color-state"
			default="1"
			validate="options">
			<option value="0">JUNPUBLISHED</option>
            <option value="1">JPUBLISHED</option>
		</field>

        <field name="access" type="accesslevel" 
            label="JFIELD_ACCESS_LABEL" 
            description="JFIELD_ACCESS_DESC" />

        <field name="note" type="text" maxlength="255"
			label="COM_SEQUENCE_FIELD_NOTE_LABEL" />
        
    </fieldset>

    <fieldset name="params">
        
        <field name="icon" type="text" maxlength="55"
            validate="CssIdentifier"
            label="COM_SEQUENCE_FIELD_ICON_LABEL" />

        <field name="css" type="text" maxlength="255"
            validate="CssIdentifier"
            label="COM_SEQUENCE_FIELD_CSS_LABEL"/>

        <field name="keep" type="radio" default="0" 
            layout="joomla.form.field.radio.switcher"
            label="COM_SEQUENCE_FIELD_KEEP_LABEL" >
            <option value="0">JNo</option>
            <option value="1">JYes</option>
        </field>

        <field name="initial" type="radio" default="0" 
            layout="joomla.form.field.radio.switcher"
            label="COM_SEQUENCE_FIELD_INITIAL_LABEL" >
            <option value="0">JNo</option>
            <option value="1">JYes</option>
        </field>
    </fieldset>
</form>