<?xml version="1.0" encoding="UTF-8"?>
<extension type="module" client="site" method="upgrade">
    <name>MOD_UPCOMINGEVENT</name>
    <version>1.0.13</version>
    <author>ToKu</author>
    <authorUrl>www.toku.cz</authorUrl>
    <license>GNU General Public License version 3 or later</license>
    <creationDate>2025-07-01</creationDate>
    <description>MOD_UPCOMINGEVENT_DESCRIPTION</description>
    <namespace path="src">ToKu\Module\UpcomingEvent</namespace>

    <!-- Sources -->
    <files>
        <folder module="mod_upcomingevent">services</folder>
        <folder>src</folder>
        <folder>tmpl</folder>
        <folder>layouts</folder>
    </files>

    <!-- Assets -->
    <media destination="mod_upcomingevent" folder="media">
        <filename>joomla.asset.json</filename>
        <folder>css</folder>
    </media>

    <languages>
        <language tag="en-GB">language/en-GB/mod_upcomingevent.ini</language>
        <language tag="en-GB">language/en-GB/mod_upcomingevent.sys.ini</language>
    </languages>

    <!-- Installation Script -->
    <scriptfile>script.php</scriptfile>

    <!-- Update Servers -->
    <updateservers>
        <server type="collection">https://joomla.toku.cz/jex.toku.xml</server>
    </updateservers>

    <!-- Module Configuration -->
    <config module="mod_upcomingevent">
        <fields name="params">
            <fieldset name="basic">

                <field name="event_field"
                    addfieldprefix="ToKu\Library\Field"
                    type="customfieldselector"
                    context="com_content.article"
                    fieldtype="calendar"
                    required="true"
                    layout="joomla.form.field.list-fancy-select"
                    label="MOD_UPCOMINGEVENT_EVENT_LABEL"
                    description="MOD_UPCOMINGEVENT_EVENT_DESCRIPTION" />

                <field
                    name="categories"
                    type="category"
                    extension="com_content"
                    multiple="true"
                    layout="joomla.form.field.list-fancy-select"
                    filter="intarray"
                    label="MOD_UPCOMINGEVENT_FILTER_CATEGORIES_LABEL"
                    description="MOD_UPCOMINGEVENT_FILTER_CATEGORIES_DESCRIPTION" />

                <field name="tags"
                    type="tag"
                    multiple="true"
                    label="MOD_UPCOMINGEVENT_FILTER_TAGS_LABEL"
                    description="MOD_UPCOMINGEVENT_FILTER_TAGS_DESCRIPTION" />

                <field
                    name="headline"
                    type="text"
                    required="true"
                    label="MOD_UPCOMINGEVENT_HEADLINE_LABEL"
                    description="MOD_UPCOMINGEVENT_HEADLINE_DESCRIPTION" />

                <field
                    name="expired_text"
                    type="text"
                    required="true"
                    label="MOD_UPCOMINGEVENT_EXPIRED_TEXT_LABEL"
                    description="MOD_UPCOMINGEVENT_EXPIRED_TEXT_DESCRIPTION" />

                <field
                    name="datetime_format"
                    type="text"
                    required="true"
                    default="l, j. F Y H:i"
                    label="MOD_UPCOMINGEVENT_DATETIME_FORMAT_LABEL"
                    description="MOD_UPCOMINGEVENT_DATETIME_FORMAT_DESCRIPTION" />

            </fieldset>

            <fieldset name="options" label="MOD_UPCOMINGEVENT_TAB_OPTIONS">

                <field
                    name="show_readmore"
                    type="radio"
                    default="1"
                    layout="joomla.form.field.radio.switcher"
                    label="MOD_UPCOMINGEVENT_READMORE_LABEL"
                    description="MOD_UPCOMINGEVENT_READMORE_DESCRIPTION">
                    <option value="0">JNo</option>
                    <option value="1">JYes</option>
                </field>

                <field
                    name="show_readmore_title"
                    type="radio"
                    showon="show_readmore:1"
                    default="1"
                    layout="joomla.form.field.radio.switcher"
                    label="MOD_UPCOMINGEVENT_READMORE_TITLE_LABEL"
                    description="MOD_UPCOMINGEVENT_READMORE_TITLE_DESCRIPTION">
                    <option value="0">JNo</option>
                    <option value="1">JYes</option>
                </field>

                <field
                    name="show_image"
                    type="radio"
                    default="1"
                    layout="joomla.form.field.radio.switcher"
                    label="MOD_UPCOMINGEVENT_IMAGE_LABEL"
                    description="MOD_UPCOMINGEVENT_IMAGE_DESCRIPTION">
                    <option value="0">JNo</option>
                    <option value="1">JYes</option>
                </field>

                <field
                    name="link_image"
                    type="radio"
                    showon="show_image:1"
                    default="1"
                    layout="joomla.form.field.radio.switcher"
                    label="MOD_UPCOMINGEVENT_LINK_LABEL"
                    description="MOD_UPCOMINGEVENT_LINK_DESCRIPTION">
                    <option value="0">JNo</option>
                    <option value="1">JYes</option>
                </field>

                <field name="countdown_labels"
                    type="text"
                    hint="days,hours,minutes,seconds"
                    label="MOD_UPCOMINGEVENT_COUNTDOWN_LABEL"
                    description="MOD_UPCOMINGEVENT_COUNTDOWN_DESCRIPTION" />

            </fieldset>

            <fieldset name="advanced">

                <field
                    name="layout"
                    type="modulelayout"
                    label="JFIELD_ALT_LAYOUT_LABEL"
                    class="form-select"
                    validate="moduleLayout" />

                <field
                    name="module_class"
                    type="text"
                    label="MOD_UPCOMINGEVENT_MODULE_CLASS_LABEL"
                    description="MOD_UPCOMINGEVENT_MODULE_CLASS_DESCRIPTION" />

            </fieldset>
        </fields>
    </config>
</extension>