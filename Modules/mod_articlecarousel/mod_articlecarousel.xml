<?xml version="1.0" encoding="UTF-8"?>
<extension type="module" client="site" method="upgrade">
    <name>MOD_ARTICLECAROUSEL</name>
    <version>1.0.6</version>
    <author>ToKu</author>
    <authorUrl>www.toku.cz</authorUrl>
    <license>GNU General Public License version 3 or later</license>
    <creationDate>2025-07-13</creationDate>
    <description>
    <![CDATA[
        <p><strong>Article Carousel Module</strong> displays random articles in an infinite carousel.
        <ul>
            <li>Configurable</li>
            <li>Supports multiple layouts</li>
            <li>Built using Joomla 5 DI, dispatcher, and asset manager</li>
            <li>Uses ToKu Library</li>
        </ul>
    ]]>
    </description>
    <namespace path="src">ToKu\Module\ArticleCarousel</namespace>

    <!-- Sources -->
    <files>
        <folder module="mod_articlecarousel">services</folder>
        <folder>src</folder>
        <folder>tmpl</folder>
    </files>

    <!-- Assets -->
    <media destination="mod_articlecarousel" folder="media">
        <filename>joomla.asset.json</filename>
        <folder>css</folder>
    </media>

    <languages>
        <language tag="en-GB">language/en-GB/mod_articlecarousel.ini</language>
        <language tag="en-GB">language/en-GB/mod_articlecarousel.sys.ini</language>
    </languages>

    <!-- Installation Script -->
    <scriptfile>script.php</scriptfile>

    <!-- Update Servers -->
    <updateservers>
        <server type="collection">https://joomla.toku.cz/toku.joomla.xml</server>
    </updateservers>

    <!-- Module Configuration -->
    <config module="mod_articlecarousel">
        <fields name="params">
            <fieldset name="basic">

                <field
                    name="categories"
                    type="category"
                    extension="com_content"
                    multiple="true"
                    layout="joomla.form.field.list-fancy-select"
                    filter="intarray"
                    label="MOD_ARTICLECAROUSEL_CATEGORIES_LABEL"
                    description="MOD_ARTICLECAROUSEL_CATEGORIES_DESCRIPTION" />

                <field name="tags"
                    type="tag"
                    multiple="true"
                    filter="intarray"
                    label="MOD_ARTICLECAROUSEL_TAGS_LABEL"
                    description="MOD_ARTICLECAROUSEL_TAGS_DESCRIPTION" />

                <field
                    name="limit"
                    type="number"
                    min="5"
                    max="20"
                    default="10"
                    label="MOD_ARTICLECAROUSEL_LIMIT_LABEL"
                    description="MOD_ARTICLECAROUSEL_LIMIT_DESCRIPTION" />

                <field
                    name="current"
                    type="radio"
                    default="0"
                    layout="joomla.form.field.radio.switcher"
                    label="MOD_ARTICLECAROUSEL_CURRENT_LABEL"
                    description="MOD_ARTICLECAROUSEL_CURRENT_DESCRIPTION">
                    <option value="0">JNo</option>
                    <option value="1">JYes</option>
                </field>

                <field
                    name="ordering"
                    type="list"
                    default="newest"
                    label="MOD_ARTICLECAROUSEL_ORDERING_LABEL"
                    description="MOD_ARTICLECAROUSEL_ORDERING_DESCRIPTION">
                    <option value="random">MOD_ARTICLECAROUSEL_ORDERING_OPTION_RANDOM</option>
                    <option value="newest">MOD_ARTICLECAROUSEL_ORDERING_OPTION_NEWEST</option>
                    <option value="oldest">MOD_ARTICLECAROUSEL_ORDERING_OPTION_OLDEST</option>
                </field>

            </fieldset>

            <fieldset name="options" label="MOD_ARTICLECAROUSEL_TAB_OPTIONS">

                <field
                    name="autoplay"
                    type="radio"
                    default="1"
                    layout="joomla.form.field.radio.switcher"
                    label="MOD_ARTICLECAROUSEL_AUTOPLAY_LABEL"
                    description="MOD_ARTICLECAROUSEL_AUTOPLAY_DESCRIPTION">
                    <option value="0">JNo</option>
                    <option value="1">JYes</option>
                </field>

                <field
                    name="interval"
                    type="number"
                    default="5000"
                    min="1000"
                    max="3600000"
                    showon="autoplay:1"
                    label="MOD_ARTICLECAROUSEL_INTERVAL_LABEL"
                    description="MOD_ARTICLECAROUSEL_INTERVAL_DESCRIPTION" />

                <field
                    name="direction"
                    type="list"
                    default="left"
                    showon="autoplay:1"
                    label="MOD_ARTICLECAROUSEL_DIRECTION_LABEL"
                    description="MOD_ARTICLECAROUSEL_DIRECTION_DESCRIPTION">
                    <option value="left">MOD_ARTICLECAROUSEL_DIRECTION_OPTION_LEFT</option>
                    <option value="right">MOD_ARTICLECAROUSEL_DIRECTION_OPTION_RIGHT</option>
                </field>

                <field
                    name="indicators"
                    type="list"
                    default="below"
                    label="MOD_ARTICLECAROUSEL_INDICATORS_LABEL"
                    description="MOD_ARTICLECAROUSEL_INDICATORS_DESCRIPTION">
                    <option value="none">MOD_ARTICLECAROUSEL_INDICATORS_OPTION_NONE</option>
                    <option value="above">MOD_ARTICLECAROUSEL_INDICATORS_OPTION_ABOVE</option>
                    <option value="below">MOD_ARTICLECAROUSEL_INDICATORS_OPTION_BELOW</option>
                </field>

                <field
                    name="show_controls"
                    type="radio"
                    default="1"
                    layout="joomla.form.field.radio.switcher"
                    label="MOD_ARTICLECAROUSEL_CONTROLS_LABEL"
                    description="MOD_ARTICLECAROUSEL_CONTROLS_DESCRIPTION">
                    <option value="0">JNo</option>
                    <option value="1">JYes</option>
                </field>

                <field
                    name="show_image"
                    type="radio"
                    default="1"
                    layout="joomla.form.field.radio.switcher"
                    label="MOD_ARTICLECAROUSEL_IMAGE_LABEL"
                    description="MOD_ARTICLECAROUSEL_IMAGE_DESCRIPTION">
                    <option value="0">JNo</option>
                    <option value="1">JYes</option>
                </field>

                <field
                    name="link_image"
                    type="radio"
                    showon="show_image:1"
                    default="1"
                    layout="joomla.form.field.radio.switcher"
                    label="MOD_ARTICLECAROUSEL_LINK_LABEL"
                    description="MOD_ARTICLECAROUSEL_LINK_DESCRIPTION">
                    <option value="0">JNo</option>
                    <option value="1">JYes</option>
                </field>

                <field
                    name="show_readmore"
                    type="radio"
                    default="1"
                    layout="joomla.form.field.radio.switcher"
                    label="MOD_ARTICLECAROUSEL_READMORE_LABEL"
                    description="MOD_ARTICLECAROUSEL_READMORE_DESCRIPTION">
                    <option value="0">JNo</option>
                    <option value="1">JYes</option>
                </field>

                <field
                    name="show_readmore_title"
                    type="radio"
                    showon="show_readmore:1"
                    default="1"
                    layout="joomla.form.field.radio.switcher"
                    label="MOD_ARTICLECAROUSEL_READMORE_TITLE_LABEL"
                    description="MOD_ARTICLECAROUSEL_READMORE_TITLE_DESCRIPTION">
                    <option value="0">JNo</option>
                    <option value="1">JYes</option>
                </field>

            </fieldset>

            <fieldset name="advanced">

                <field
                    name="layout"
                    type="modulelayout"
                    label="JFIELD_ALT_LAYOUT_LABEL"
                    class="form-select"
                    validate="moduleLayout" />

                <field
                    name="module_class"
                    type="text"
                    validate="CssIdentifier"
                    label="MOD_ARTICLECAROUSEL_MODULE_CLASS_LABEL"
                    description="MOD_ARTICLECAROUSEL_MODULE_CLASS_DESCRIPTION" />

                <field
                    name="box_class"
                    type="text"
                    validate="CssIdentifier"
                    label="MOD_ARTICLECAROUSEL_ITEM_CLASS_LABEL"
                    description="MOD_ARTICLECAROUSEL_ITEM_CLASS_DESCRIPTION" />

            </fieldset>
        </fields>
    </config>
</extension>