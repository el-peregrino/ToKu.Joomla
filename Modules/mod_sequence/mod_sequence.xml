<?xml version="1.0" encoding="UTF-8"?>
<extension type="module" client="site" method="upgrade">
    <name>MOD_SEQUENCE</name>
    <version>2.0.0</version>
    <author>ToKu</author>
    <creationDate>2025-01-31</creationDate>
    <description>MOD_SEQUENCE_DESCRIPTION</description>
    <namespace path="src">ToKu\Module\Sequence</namespace>
    <files>
        <folder module="mod_sequence">services</folder>
        <folder>src</folder>
        <folder>tmpl</folder>
    </files>
    <media destination="mod_sequence" folder="media">
        <filename>joomla.asset.json</filename>
        <folder>css</folder>
        <folder>images</folder>
    </media>
    <config>
        <fields name="params">

            <fieldset name="basic">
                
                <field
                    name="sequence"
                    type="sql"
                    required="true"
                    query="SELECT id AS value, title AS text FROM #__sequences WHERE published = 1 ORDER BY title ASC"
                    label="MOD_SEQUENCE_FIELD_SEQUENCE_LABEL"/>

                <field 
                    name="sequence_css"
                    type="text"
                    validate="CssIdentifier"
                    label="MOD_SEQUENCE_FIELD_SEQUENCE_CSS_LABEL" />

                <field 
                    name="item_css"
                    type="text"
                    validate="CssIdentifier"
                    label="MOD_SEQUENCE_FIELD_ITEM_CSS_LABEL" />

            </fieldset>

            <fieldset name="options" label="MOD_SEQUENCE_TAB_OPTIONS">

                <field 
                    name="show_title" 
                    type="radio" 
                    default="0" 
                    layout="joomla.form.field.radio.switcher"
                    label="MOD_SEQUENCE_FIELD_SHOW_TITLE_LABEL" >
                    <option value="0">JNo</option>
                    <option value="1">JYes</option>
                </field>

                <field 
                    name="collapsible" 
                    type="radio" 
                    default="1" 
                    layout="joomla.form.field.radio.switcher"
                    label="MOD_SEQUENCE_FIELD_COLLAPSIBLE_LABEL" >
                    <option value="0">JNo</option>
                    <option value="1">JYes</option>
                </field>

                <field
                    name="mode" 
                    type="list" 
                    showon="collapsible:1"
                    default="single" 
                    label="MOD_SEQUENCE_FIELD_EXPANSION_MODE_LABEL" >
                    <option value="single">MOD_SEQUENCE_EXPANSION_MODE_SINGLE</option>
                    <option value="multiple">MOD_SEQUENCE_EXPANSION_MODE_MULTIPLE</option>
                </field>

                <field
                    name="align" 
                    type="list" 
                    default="center" 
                    label="MOD_SEQUENCE_FIELD_ALIGN_LABEL" >
                    <option value="center">MOD_SEQUENCE_ALIGN_CENTER</option>
                    <option value="left">MOD_SEQUENCE_ALIGN_LEFT</option>
                    <option value="right">MOD_SEQUENCE_ALIGN_RIGHT</option>
                </field>

            </fieldset>

        </fields>
    </config>
</extension>