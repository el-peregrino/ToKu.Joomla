<?xml version="1.0" encoding="UTF-8"?>
<extension type="module" client="site" method="upgrade">
    <name>MOD_SEQUENCE</name>
    <version>1.0.5</version>
    <author>ToKu</author>
    <creationDate>2025-01-31</creationDate>
    <description>MOD_SEQUENCE_DESCRIPTION</description>
    <namespace path="src">ToKu\Module\Sequence</namespace>

    <!-- Sources -->
    <files>
        <folder module="mod_sequence">services</folder>
        <folder>src</folder>
        <folder>tmpl</folder>
    </files>

    <!-- Assets -->
    <media destination="mod_sequence" folder="media">
        <filename>joomla.asset.json</filename>
        <folder>css</folder>
        <folder>images</folder>
    </media>

    <media destination="layouts" folder="layouts" />

    <languages>
        <language tag="en-GB">language/en-GB/mod_sequence.ini</language>
        <language tag="en-GB">language/en-GB/mod_sequence.sys.ini</language>
    </languages>

    <!-- Installation Script -->
    <scriptfile>script.php</scriptfile>

    <!-- Update Servers -->
    <updateservers>
        <server type="collection">https://joomla.toku.cz/toku.joomla.xml</server>
    </updateservers>

    <!-- Module Configuration -->
    <config module="mod_sequence">
        <fields name="params">

            <fieldset name="basic">
                
                <field
                    name="sequence"
                    type="sql"
                    required="true"
                    key_field="id"
                    value_field="title"
                    query="SELECT id, title FROM #__sequences WHERE published = 1 ORDER BY title ASC"
                    label="MOD_SEQUENCE_FIELD_SEQUENCE_LABEL"/>

                <field 
                    name="ordering" 
                    type="list" 
                    default="component"
                    label="MOD_SEQUENCE_FIELD_ORDERING_LABEL" 
                    description="MOD_SEQUENCE_FIELD_ORDERING_DESCRIPTION">
                    <option value="component">MOD_SEQUENCE_ORDERING_OPTION_COMPONENT</option>
                    <option value="random">MOD_SEQUENCE_ORDERING_OPTION_RANDOM</option>
                    <option value="heading">MOD_SEQUENCE_ORDERING_OPTION_HEADING</option>
                </field>

                <field 
                    name="direction" 
                    type="list" 
                    default="component"
                    label="MOD_SEQUENCE_FIELD_DIRECTION_LABEL" 
                    description="MOD_SEQUENCE_FIELD_DIRECTION_DESCRIPTION">
                    <option value="component">MOD_SEQUENCE_DIRECTION_OPTION_COMPONENT</option>
                    <option value="reverse">MOD_SEQUENCE_DIRECTION_OPTION_REVERSE</option>
                    <option value="ascending">MOD_SEQUENCE_DIRECTION_OPTION_ASCENDING</option>
                    <option value="descending">MOD_SEQUENCE_DIRECTION_OPTION_DESCENDING</option>
                </field>

            </fieldset>

            <fieldset name="module-frame" label="MOD_SEQUENCE_TAB_MODULE_FRAME" description="MOD_SEQUENCE_HELP_MODULE_FRAME">

                <field 
                    name="keep_header_text" 
                    type="radio" 
                    default="0" 
                    layout="joomla.form.field.radio.switcher"
                    label="MOD_SEQUENCE_FIELD_KEEP_HEADER_TITLE_LABEL" >
                    <option value="0">JNo</option>
                    <option value="1">JYes</option>
                </field>

                <field 
                    name="keep_header_image" 
                    type="radio" 
                    default="0" 
                    layout="joomla.form.field.radio.switcher"
                    label="MOD_SEQUENCE_FIELD_KEEP_HEADER_IMAGE_LABEL" >
                    <option value="0">JNo</option>
                    <option value="1">JYes</option>
                </field>

                <field 
                    name="keep_footer_text" 
                    type="radio" 
                    default="0" 
                    layout="joomla.form.field.radio.switcher"
                    label="MOD_SEQUENCE_FIELD_KEEP_FOOTER_TITLE_LABEL" >
                    <option value="0">JNo</option>
                    <option value="1">JYes</option>
                </field>

                <field 
                    name="keep_footer_image" 
                    type="radio" 
                    default="0" 
                    layout="joomla.form.field.radio.switcher"
                    label="MOD_SEQUENCE_FIELD_KEEP_FOOTER_IMAGE_LABEL" >
                    <option value="0">JNo</option>
                    <option value="1">JYes</option>
                </field>

            </fieldset>

            <fieldset name="options" label="MOD_SEQUENCE_TAB_OPTIONS">

                <field 
                    name="collapsible" 
                    type="radio" 
                    default="1" 
                    layout="joomla.form.field.radio.switcher"
                    label="MOD_SEQUENCE_FIELD_COLLAPSIBLE_LABEL" >
                    <option value="0">JNo</option>
                    <option value="1">JYes</option>
                </field>

                <field
                    name="mode" 
                    type="list" 
                    showon="collapsible:1"
                    default="single" 
                    label="MOD_SEQUENCE_FIELD_EXPANSION_MODE_LABEL" >
                    <option value="single">MOD_SEQUENCE_EXPANSION_MODE_OPTION_SINGLE</option>
                    <option value="multiple">MOD_SEQUENCE_EXPANSION_MODE_OPTION_MULTIPLE</option>
                </field>

                <field
                    name="align" 
                    type="list" 
                    default="center" 
                    label="MOD_SEQUENCE_FIELD_ALIGN_LABEL" >
                    <option value="center">MOD_SEQUENCE_ALIGN_OPTION_CENTER</option>
                    <option value="left">MOD_SEQUENCE_ALIGN_OPTION_LEFT</option>
                    <option value="right">MOD_SEQUENCE_ALIGN_OPTION_RIGHT</option>
                </field>

                <field
                    name="datetime_format"
                    type="text"
                    required="true"
                    default="l, j. F Y H:i"
                    label="MOD_SEQUENCE_FIELD_DATETIME_FORMAT_LABEL"
                    description="MOD_SEQUENCE_FIELD_DATETIME_FORMAT_DESCRIPTION" />

            </fieldset>

            <fieldset name="advanced">

                <field
                    name="layout"
                    type="modulelayout"
                    label="JFIELD_ALT_LAYOUT_LABEL"
                    class="form-select"
                    validate="moduleLayout" />

                <field 
                    name="module_class"
                    type="text"
                    validate="CssIdentifier"
                    label="MOD_SEQUENCE_FIELD_MODULE_CLASS_LABEL"
                    description="MOD_SEQUENCE_FIELD_MODULE_CLASS_DESCRIPTION" />

                <field 
                    name="box_class"
                    type="text"
                    validate="CssIdentifier"
                    label="MOD_SEQUENCE_FIELD_BOX_CLASS_LABEL"
                    description="MOD_SEQUENCE_FIELD_BOX_CLASS_DESCRIPTION" />

            </fieldset>

        </fields>
    </config>
</extension>