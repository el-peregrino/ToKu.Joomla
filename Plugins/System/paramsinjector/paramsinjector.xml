<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
    <name>PLG_PARAMSINJECTOR</name>
    <author>ToKu</author>
    <authorUrl>www.toku.cz</authorUrl>
    <license>GNU General Public License version 3 or later</license>
    <creationDate>2025-09-18</creationDate>
    <version>1.1.0</version>
    <description>PLG_PARAMSINJECTOR_DESCRIPTION</description>
    <namespace path="src">ToKu\Plugin\System\ParamsInjector</namespace>

    <!-- Assets -->
    <languages>
        <language tag="en-GB">language/en-GB/plg_system_paramsinjector.ini</language>
        <language tag="en-GB">language/en-GB/plg_system_paramsinjector.sys.ini</language>
    </languages>

    <!-- Sources -->
    <files>
        <folder plugin="paramsinjector">services</folder>
        <folder>src</folder>
        <folder>forms</folder>
    </files>

    <!-- Update Servers -->
    <updateservers>
        <server type="collection">https://joomla.toku.cz/jex.toku.xml</server>
    </updateservers>

    <!-- Plugin Configuration -->
    <config module="mod_sequence">
        <fields name="params">
            <fieldset name="basic">

                <field 
                    name="module_frame" 
                    type="radio" 
                    default="0" 
                    layout="joomla.form.field.radio.switcher"
                    label="PLG_PARAMSINJECTOR_CONFIG_MODULE_FRAME_LABEL"
                    description="PLG_PARAMSINJECTOR_CONFIG_MODULE_FRAME_DESCRIPTION" >
                    <option value="0">JNo</option>
                    <option value="1">JYes</option>
                </field>

                <field 
                    name="menu_item" 
                    type="radio" 
                    default="0" 
                    layout="joomla.form.field.radio.switcher"
                    label="PLG_PARAMSINJECTOR_CONFIG_MENU_ITEM_LABEL"
                    description="PLG_PARAMSINJECTOR_CONFIG_MENU_ITEM_DESCRIPTION" >
                    <option value="0">JNo</option>
                    <option value="1">JYes</option>
                </field>

            </fieldset>
        </fields>
    </config>
</extension>