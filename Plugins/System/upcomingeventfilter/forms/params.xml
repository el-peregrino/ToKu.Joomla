<?xml version="1.0" encoding="utf-8"?>
<form>
    <fields name="params">
        <fieldset name="upcomingeventfilter-params" label="PLG_UPCOMINGEVENTFILTER_TAB_EVENT_FILTER" description="PLG_UPCOMINGEVENTFILTER_HELP_EVENT_FILTER">

            <field
                name="eventfilter_enabled"
                type="radio"
                default="0"
                layout="joomla.form.field.radio.switcher"
                label="PLG_UPCOMINGEVENTFILTER_FIELD_ENABLE_LABEL">
                <option value="0">JNo</option>
                <option value="1">JYes</option>
            </field>

            <field
                name="eventfilter_event_field"
                addfieldprefix="ToKu\Library\Field"
                type="customfieldselector"
                context="com_content.article"
                fieldtype="calendar"
                layout="joomla.form.field.list-fancy-select"
                required="true" 
                showon="eventfilter_enabled:1"
                label="PLG_UPCOMINGEVENTFILTER_FIELD_EVENT_LABEL"
                description="PLG_UPCOMINGEVENTFILTER_FIELD_EVENT_DESCRIPTION"/>

            <field
                name="eventfilter_show_past"
                type="radio"
                default="0"
                showon="eventfilter_enabled:1"
                layout="joomla.form.field.radio.switcher"
                label="PLG_UPCOMINGEVENTFILTER_FIELD_SHOW_PAST_LABEL"
                description="PLG_UPCOMINGEVENTFILTER_FIELD_SHOW_PAST_DESCRIPTION">
                <option value="0">JNo</option>
                <option value="1">JYes</option>
            </field>

            <field
                name="eventfilter_order_events"
                type="list"
                default="none"
                required="true"
                showon="eventfilter_enabled:1"
                label="PLG_UPCOMINGEVENTFILTER_FIELD_ORDER_LABEL"
                description="PLG_UPCOMINGEVENTFILTER_FIELD_ORDER_DESCRIPTION">
                <option value="none">PLG_UPCOMINGEVENTFILTER_ORDER_OPTION_NONE</option>
                <option value="ascending">PLG_UPCOMINGEVENTFILTER_ORDER_OPTION_ASCENDING</option>
                <option value="descending">PLG_UPCOMINGEVENTFILTER_ORDER_OPTION_DESCENDING</option>
            </field>

        </fieldset>
    </fields>
</form>